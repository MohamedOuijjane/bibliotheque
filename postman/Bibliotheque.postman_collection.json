          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/livres",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "livres"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titre\": \"Le Petit Prince\",\n  \"auteur\": \"Antoine de Saint-Exupéry\",\n  \"anneePublication\": 1943,\n  \"isbn\": \"978-2-07-040525-0\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
